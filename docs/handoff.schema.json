{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff/v1",
  "title": "Paquete de handoff del agente de disputas (v1)",
  "description": "Lo arma src/bankagent/handoff.py; cola, prioridad, SLA y preguntas por motivo salen de config/policy.yaml (handoff). Contrato probado en tests/test_handoff.py.",
  "type": "object",
  "required": ["schema_version", "handoff_id", "created_at", "as_of", "reason", "queue", "priority", "sla_hours",
               "next_action", "language", "request", "transcript", "customer_claim", "match", "verified_facts",
               "policy", "actions_taken", "evidence", "failures", "unresolved_questions", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["handoff/v1"]},
    "handoff_id": {"type": "string", "description": "HND-XXXXXXXXXX; el cliente lo recibe en su idioma y queda en el log de auditoría"},
    "created_at": {"type": "string", "description": "ISO 8601 en UTC"},
    "as_of": {"type": "string", "description": "fecha de los datos (policy.as_of)"},
    "reason": {"type": "string", "description": "id de regla (H01–H04) o motivo técnico/conversacional"},
    "queue": {"type": "string", "enum": ["fraude", "seguridad", "disputas", "servicio", "operaciones"]},
    "priority": {"type": "string", "enum": ["alta", "media", "baja"]},
    "sla_hours": {"type": "number", "minimum": 0},
    "next_action": {"type": "string"},
    "language": {"type": "string", "enum": ["es", "pt"]},
    "request": {"type": "array", "description": "últimos mensajes del CLIENTE, enmascarados"},
    "transcript": {"type": "array", "description": "conversación con el rol de cada mensaje (user/assistant)"},
    "customer_claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {"type": "number"},
        "date_from": {"type": "string"},
        "date_to": {"type": "string"},
        "country": {"type": "string"},
        "merchant": {"type": "array"},
        "count": {"type": "integer"}
      }
    },
    "match": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["transaction_id", "selected_by", "amount_diff", "date_diff_days"],
          "additionalProperties": false,
          "properties": {
            "transaction_id": {"type": "string"},
            "selected_by": {"type": "string", "enum": ["single_candidate", "customer_choice", "unknown"]},
            "amount_diff": {"anyOf": [{"type": "number"}, {"type": "null"}]},
            "date_diff_days": {"anyOf": [{"type": "integer"}, {"type": "null"}]}
          }
        }
      ]
    },
    "verified_facts": {
      "type": "object",
      "required": ["transaction"],
      "additionalProperties": false,
      "properties": {
        "transaction": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "description": "lista blanca de campos (minimización de datos)",
              "properties": {
                "transaction_id": {"type": "string"},
                "transaction_date": {"type": "string"},
                "transaction_type": {"type": "string"},
                "amount": {"type": "number"},
                "currency": {"type": "string"},
                "channel": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "merchant_name": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "transaction_country": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "transaction_city": {"anyOf": [{"type": "string"}, {"type": "null"}]},
                "transaction_status": {"type": "string"},
                "fraud_score": {"anyOf": [{"type": "number"}, {"type": "null"}]}
              }
            }
          ]
        },
        "customer_status": {"type": "string"},
        "segment": {"type": "string"},
        "complaints_last_90d": {"type": "integer"},
        "is_repeat_complainer": {"type": "boolean"},
        "open_dispute_transactions": {"type": "array"}
      }
    },
    "policy": {
      "type": "object",
      "required": ["version", "rules_fired"],
      "properties": {
        "version": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "rules_fired": {"type": "array", "description": "TODAS las reglas que se cumplieron, en orden de prioridad"}
      }
    },
    "actions_taken": {"type": "array"},
    "evidence": {"type": "array"},
    "failures": {"type": "array", "description": "herramientas que fallaron: {turn, tool, error}"},
    "unresolved_questions": {"type": "array", "description": "preguntas abiertas por motivo (policy.yaml) + reconocimiento del movimiento"},
    "summary": {"type": "string"},
    "audit": {
      "type": "object",
      "description": "solo con log de auditoría: registro encadenado del nodo handoff",
      "properties": {"thread": {"type": "string"}, "seq": {"type": "integer"}, "hash": {"type": "string"}}
    }
  }
}
